`include "fifo.sv"
`timescale 1ns/1ps

module async_fifo_tb;

    // =========================================================
    // PARAMETERS
    // =========================================================

    parameter DATA_WIDTH = 8;
    parameter ADDR_WIDTH = 3;


    // =========================================================
    // TESTBENCH SIGNALS
    // =========================================================

    logic wr_clk;
    logic rd_clk;

    logic wr_rst_n;
    logic rd_rst_n;

    logic wr_en;
    logic rd_en;

    logic [DATA_WIDTH-1:0] wr_data;
    logic [DATA_WIDTH-1:0] rd_data;

    logic full;
    logic empty;


    // =========================================================
    // DUT INSTANTIATION
    // =========================================================

    async_fifo #(
        .DATA_WIDTH(DATA_WIDTH),
        .ADDR_WIDTH(ADDR_WIDTH)
    ) dut (
        .wr_clk  (wr_clk),
        .rd_clk  (rd_clk),

        .wr_rst_n(wr_rst_n),
        .rd_rst_n(rd_rst_n),

        .wr_en   (wr_en),
        .rd_en   (rd_en),

        .wr_data (wr_data),
        .rd_data (rd_data),

        .full    (full),
        .empty   (empty)
    );


    // =========================================================
    // WRITE CLOCK
    // Period = 10 ns
    // =========================================================

    initial begin
        wr_clk = 1'b0;

        forever #5 wr_clk = ~wr_clk;
    end


    // =========================================================
    // READ CLOCK
    // Period = 14 ns
    // =========================================================

    initial begin
        rd_clk = 1'b0;

        forever #7 rd_clk = ~rd_clk;
    end


    // =========================================================
    // RESET
    // =========================================================

    initial begin

        wr_rst_n = 1'b0;
        rd_rst_n = 1'b0;

        wr_en    = 1'b0;
        rd_en    = 1'b0;

        wr_data  = '0;

        #20;

        wr_rst_n = 1'b1;
        rd_rst_n = 1'b1;

    end


    // =========================================================
    // WRITE TASK
    // =========================================================

    task write_data(input logic [DATA_WIDTH-1:0] data);

        begin

            @(posedge wr_clk);

            if (!full) begin

                wr_en   <= 1'b1;
                wr_data <= data;

                @(posedge wr_clk);

                wr_en <= 1'b0;

                $display("TIME=%0t : WRITE DATA = %0h",
                         $time, data);

            end
            else begin

                $display("TIME=%0t : FIFO FULL - WRITE FAILED",
                         $time);

            end

        end

    endtask


    // =========================================================
    // READ TASK
    // =========================================================

    task read_data;

        begin

            @(posedge rd_clk);

            if (!empty) begin

                rd_en <= 1'b1;

                @(posedge rd_clk);

                rd_en <= 1'b0;

                $display("TIME=%0t : READ DATA = %0h",
                         $time, rd_data);

            end
            else begin

                $display("TIME=%0t : FIFO EMPTY - READ FAILED",
                         $time);

            end

        end

    endtask


    // =========================================================
    // MAIN TEST
    // =========================================================

    initial begin

        // Wait for reset
        #30;

        $display("----------------------------------");
        $display("STARTING ASYNC FIFO TEST");
        $display("----------------------------------");


        // -----------------------------------------------------
        // WRITE DATA
        // -----------------------------------------------------

        write_data(8'hA1);
        write_data(8'hB2);
        write_data(8'hC3);
        write_data(8'hD4);


        // Give time for write pointer
        // to synchronize into read domain
        #50;


        // -----------------------------------------------------
        // READ DATA
        // -----------------------------------------------------

        read_data;
        read_data;
        read_data;
        read_data;


        // -----------------------------------------------------
        // WAIT
        // -----------------------------------------------------

        #100;


        $display("----------------------------------");
        $display("ASYNC FIFO TEST COMPLETED");
        $display("----------------------------------");

        $finish;

    end


    // =========================================================
    // MONITOR
    // =========================================================

    initial begin

        $monitor("TIME=%0t | wr_clk=%b rd_clk=%b | wr_en=%b rd_en=%b | wr_data=%h rd_data=%h | FULL=%b EMPTY=%b",
                 $time,
                 wr_clk,
                 rd_clk,
                 wr_en,
                 rd_en,
                 wr_data,
                 rd_data,
                 full,
                 empty);

    end


endmodule
